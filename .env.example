# ============================================================
# Google Cloud Daily Briefing Agent - Environment Variables
# ============================================================

# [REQUIRED] Google Gemini API Key
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Gemini Model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# [OPTIONAL] Webhook endpoints for publishing the briefing
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# [OPTIONAL] Lookback duration in hours (default: 24)
LOOKBACK_HOURS=24

# [OPTIONAL] Include Google Cloud Blog articles in digest (true / false, default: true)
INCLUDE_BLOG=true
